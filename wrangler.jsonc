{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loskutovy-finance",
  "main": "./worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loskutovy-finance",
      "database_id": "4973ba7f-ce47-45b2-b860-ef8058cd2ac0"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
